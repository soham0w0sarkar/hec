# Copy to .env and fill in. Never commit .env.

# Hosted Supabase Postgres (pooler URI). URL-encode the password.
# Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Display name for each person id. Written into the people table by `bun run db:migrate`.
# Ids are fixed (person_1, person_2); only the names are yours to choose. Extraction reads these names.
PEOPLE_DISPLAY_NAMES={"person_1":"<first person's name>","person_2":"<second person's name>"}

# Redis Cloud. redis:// or rediss:// (TLS), with the password in the URL.
REDIS_URL=redis://default:[password]@[host]:[port]

# Event extraction (Sarvam chat). Model: sarvam-105b.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
# Extraction backend: sarvam (default), local (an Ollama server), or bedrock (billed to the AWS account).
EXTRACTION_PROVIDER=sarvam
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_URL=http://127.0.0.1:11434
BEDROCK_MODEL_ID=qwen.qwen3-32b-v1:0
BEDROCK_REGION=us-east-1

# Embeddings (OpenAI). Dimension must match the vector(1536) column.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Worker: sessions extracted at the same time (1 to 8).
EXTRACTION_CONCURRENCY=2

# API
PORT=3001
