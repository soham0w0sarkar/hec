# Copy to .env and fill in. Never commit .env.

# Hosted Supabase Postgres (pooler URI). URL-encode the password.
# Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Display name for each person id. Written into the people table by `bun run db:migrate`.
# Ids are fixed (person_1, person_2); only the names are yours to choose.
PEOPLE_DISPLAY_NAMES={"person_1":"<first person's name>","person_2":"<second person's name>"}

# Redis - matches docker-compose.yml
REDIS_URL=redis://localhost:6379

# LLM + embeddings provider (provider not chosen yet)
LLM_API_KEY=
EMBEDDING_API_KEY=

# API
PORT=3001
