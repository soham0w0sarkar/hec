{
  "name": "hec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:migrate": "bun --filter @hec/db migrate",
    "ingest": "bun --filter @hec/ingest ingest",
    "sessionize": "bun --filter @hec/sessionizer sessionize",
    "embed": "bun --filter @hec/embeddings embed",
    "search": "bun --filter @hec/retrieval search",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "worker": "bun --filter @hec/worker start",
    "extract": "bun --filter @hec/extraction extract",
    "review": "bun --env-file=.env packages/extraction/src/cli.ts review",
    "review:export": "bun --env-file=.env packages/extraction/src/cli.ts review:export",
    "review:import": "bun --env-file=.env packages/extraction/src/cli.ts review:import",
    "evals": "bun --filter @hec/extraction evals"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
