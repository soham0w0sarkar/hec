{
  "name": "hec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:migrate": "bun --filter @hec/db migrate",
    "ingest": "bun --filter @hec/ingest ingest",
    "sessionize": "bun --filter @hec/sessionizer sessionize",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
